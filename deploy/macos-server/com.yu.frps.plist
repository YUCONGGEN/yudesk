<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yu.frps</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/yu/bin/frp/frps</string>
    <string>-c</string>
    <string>/Users/yu/bin/frp/frps.toml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/yu/bin/frp</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/yu/bin/frp/frps-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yu/bin/frp/frps-launchd.log</string>
  <key>ThrottleInterval</key>
  <integer>2</integer>
</dict>
</plist>
